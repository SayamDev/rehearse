# Free AI notes: create a key at https://console.groq.com (free tier, no card).
# In the Groq console, turn on Zero Data Retention under Data Controls.
# Leave empty and the app uses its built-in rule-based notes instead.
GROQ_API_KEY=
# Optional: another Groq model that supports strict structured outputs.
# GROQ_MODEL=openai/gpt-oss-120b

# Only if you are ever given donated Claude credits. Leave empty to stay free.
ANTHROPIC_API_KEY=
# Claude is paid. It stays off unless this is exactly "yes", even when a key is set above.
ALLOW_PAID_AI=

# Each visitor's daily share of the free AI quota. Past it they get rule-based notes.
DAILY_GRADE_LIMIT=20
DAILY_QUESTION_LIMIT=10
DAILY_COACH_LIMIT=20
DAILY_REACT_LIMIT=60
DAILY_TRANSCRIBE_LIMIT=120
